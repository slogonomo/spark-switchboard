# /etc/systemd/system/spark-switchboard.service, rendered and installed by deploy/install.sh.
[Unit]
Description=spark-switchboard: on-demand front door for the model services on this machine
After=network-online.target@AFTER_DOCKER@
Wants=network-online.target

[Service]
User=@USER@
Group=@GROUP@
@SUPPLEMENTARY_GROUPS@
WorkingDirectory=@HOME@
Environment=PYTHONUNBUFFERED=1
ExecStart="@VENV@/bin/spark-switchboard" serve -c "@CONFIG@"
Restart=on-failure
RestartSec=3
# The apps switchboard starts (their launchers and containers) outlive a switchboard restart or upgrade: the new
# process re-adopts them through their pidfiles. Only the main process gets the stop signal. To stop everything:
# `<repo>/.venv/bin/spark-switchboard pause` (stops the apps and keeps keep-warm apps from coming back), wait until
# `spark-switchboard status` shows none running, then `systemctl stop spark-switchboard` (deploy/uninstall.sh does
# all of this). A restart of switchboard resumes a pause, unless the pause persists (pause_persists in the config, or
# `spark-switchboard pause --persist`): then it stays paused until `spark-switchboard resume`.
KillMode=process
TimeoutStopSec=15

[Install]
WantedBy=multi-user.target
